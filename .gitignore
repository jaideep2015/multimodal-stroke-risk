/data/*
!/data/processed/
/data/processed/*
# Phase 4 outputs are the exception: small CSVs worth committing so results
# survive being generated on a throwaway Colab/Kaggle VM. Everything else
# under data/ (raw dataset, patient_cohort.csv, patient_folds.csv, model
# checkpoints) stays ignored -- a parent-directory ignore rule (the old
# bare "/data/") can't be selectively un-ignored file-by-file in git, hence
# ignoring contents (data/processed/*) rather than the directory itself.
!/data/processed/mri_embeddings_fold0.csv
!/data/processed/mri_embeddings_fold1.csv
!/data/processed/mri_embeddings_fold2.csv
!/data/processed/mri_embeddings_fold3.csv
!/data/processed/mri_embeddings_fold4.csv
!/data/processed/mri_baseline_metrics.csv
!/data/processed/ehr_baseline_metrics.csv
!/data/processed/fusion_metrics.csv
!/data/processed/fusion_late_metrics.csv
!/data/processed/comparison_table.csv

*.ckpt
*.pt
*.pth
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
wandb/

# Checkpoints are gitignored by default (they're the large-binary case the
# *.pt rule above exists for). mri_fold0.pt is a deliberate, named exception
# for Grad-CAM (Phase 7) -- but it needs the same nested pattern as the
# data/processed/ exceptions above: /data/processed/* (further up) already
# matches "checkpoints" as a directory entry and stops git from recursing
# into it at all, so a bare per-file negation here is silently ineffective
# (this is exactly why committing it initially needed `git add -f`). Un-
# ignoring the directory first, then re-ignoring its contents, then negating
# just this one file is what actually works. This block must also stay
# AFTER the *.pt rule above -- gitignore uses last-match-wins, so if this
# came first, *.pt would still win and re-ignore the file.
!/data/processed/checkpoints/
/data/processed/checkpoints/*
!/data/processed/checkpoints/mri_fold0.pt
